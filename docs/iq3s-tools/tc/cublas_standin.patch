+// EXPERIMENT (FNFL_TC_CUBLAS=1, the tensor-core ceiling): every prompt dense product (pd_tc, pq_tc, pl_tc) replaced by
+// a cuBLAS FP16 GEMM of the same rows x n x k on a dummy FP16 weight, into a scratch output: the time a CUTLASS-class
+// kernel with in-loader decode could take. Outputs are not written (garbage downstream): timing only.
+namespace {
+struct cb_dev {
+    cublasHandle_t h = nullptr;
+    uint16_t * w = nullptr;
+    uint16_t * out = nullptr;
+    size_t w_n = 0, out_n = 0;
+};
+bool cb_on() {
+    static const bool on = [] {
+        const char * e = std::getenv("FNFL_TC_CUBLAS");
+        const bool v = e != nullptr && e[0] == '1';
+        if (v) {
+            std::fprintf(stderr, "fn::dense: EXPERIMENT prompt dense products as cuBLAS GEMMs (FNFL_TC_CUBLAS)\n");
+        }
+        return v;
+    }();
+    return on;
+}
+bool cb_gemm(const pt_args & t, void * stream) {
+    static cb_dev d[8];
+    int dev = 0;
+    if (cudaGetDevice(&dev) != cudaSuccess || dev < 0 || dev >= 8) {
+        return false;
+    }
+    cb_dev & c = d[dev];
+    if (c.h == nullptr && cublasCreate(&c.h) != CUBLAS_STATUS_SUCCESS) {
+        return false;
+    }
+    const size_t wn = size_t(t.n) * size_t(t.k), on = size_t(t.rows) * size_t(t.n);
+    if (wn > c.w_n) {
+        cudaFree(c.w);
+        if (cudaMalloc(&c.w, wn * 2) != cudaSuccess) {
+            return false;
+        }
+        cudaMemset(c.w, 0x3a, wn * 2); // FP16 0x3a3a (~0.78): non-zero, so the tensor cores draw realistic power
+        c.w_n = wn;
+    }
+    if (on > c.out_n) {
+        cudaFree(c.out);
+        if (cudaMalloc(&c.out, on * 2) != cudaSuccess) {
+            return false;
+        }
+        c.out_n = on;
+    }
+    cublasSetStream(c.h, static_cast<cudaStream_t>(stream));
+    const float one = 1.0f, zero = 0.0f;
+    // row-major C[rows][n] = X[rows][k] W[n][k]^T, as column-major C^T (n x rows) = W^T' X^T'; a K split (two
+    // activation sources) as two accumulating GEMMs
+    const int32_t k0 = t.x.a1 != nullptr && t.x.k_split > 0 ? t.x.k_split : t.k;
+    const auto g = [&](int32_t kk, const uint16_t * w, const uint16_t * x, int64_t ld, const float * beta) {
+        return cublasGemmEx(c.h, CUBLAS_OP_T, CUBLAS_OP_N, t.n, t.rows, kk, &one, w, CUDA_R_16F, t.k, x, CUDA_R_16F,
+                            static_cast<int>(ld > 0 ? ld : kk), beta, c.out, CUDA_R_16F, t.n, CUBLAS_COMPUTE_32F,
+                            CUBLAS_GEMM_DEFAULT_TENSOR_OP) == CUBLAS_STATUS_SUCCESS;
+    };
+    if (!g(k0, c.w, t.x.a0, t.x.ld0, &zero)) {
+        return false;
+    }
+    return k0 == t.k || g(t.k - k0, c.w + k0, t.x.a1, t.x.ld1, &one);
+}
