+// wide: the cost of more verify rows on one weight read. Lone product at B = 1, 4, 5 against the joint launch
+// (FMU2) at U lanes of R rows, U R rows packed, every weight read once; warm and cold, per launch. The joint launch's
+// rows are bitwise the lone launch's at B = R (dense_joint_test), so it stands in for a wide verify's product.
+bool run_wide(bench & bn, const char * only) {
+    struct cfg {
+        int32_t lanes, rows;
+        bool f16;
+    };
+    const std::vector<cfg> cfgs = {{1, 1, false}, {1, 4, false}, {1, 5, false}, {2, 4, false}, {2, 5, false},
+                                   {3, 4, false}, {4, 4, false}, {4, 5, false}, {3, 4, true},  {4, 4, true}};
+    printf("{\"wide\": \"header\", \"cols\": \"group, weight_bytes, lanes, rows, total_rows, f16, warm_us, cold_us\"}\n");
+    for (const group_def & d : all_defs()) {
+        if (d.conv || (only != nullptr && d.name.find(only) == std::string::npos)) {
+            continue;
+        }
+        bool f32 = false;
+        for (const mdef & m : d.mats) {
+            f32 = f32 || m.f == fmt::f32;
+        }
+        if (f32) {
+            continue; // the joint launch rejects F32 weights
+        }
+        group g;
+        if (!bn.make(d, 0, g)) {
+            return false;
+        }
+        for (const cfg & c : cfgs) {
+            joint_args j;
+            j.lanes = c.lanes;
+            j.rows = c.rows;
+            j.dense_f16 = c.f16;
+            const auto unit = [&](int32_t cc) {
+                if (c.lanes == 1) {
+                    return bn.launch(g, c.rows, cc);
+                }
+                const product_args a = g.args(cc, bn.xc.as<int8_t>(), bn.xs.as<float>(), bn.xf.as<float>(),
+                                              bn.grids.p, bn.scale.as<float>());
+                if (!product_joint(a, j, bn.st)) {
+                    fprintf(stderr, "dp-bench wide: %s U %d R %d not enqueued\n", d.name.c_str(), c.lanes, c.rows);
+                    return false;
+                }
+                return true;
+            };
+            if (!unit(0) || !cuda_ok(cudaStreamSynchronize(bn.st), "wide probe")) {
+                cudaGetLastError();
+                printf("{\"wide\": \"%s\", \"lanes\": %d, \"rows\": %d, \"f16\": %s, \"skipped\": true}\n",
+                       d.name.c_str(), c.lanes, c.rows, c.f16 ? "true" : "false");
+                continue;
+            }
+            stats warm, cold;
+            if (!time_warm(bn, n_unit, unit, warm) || !time_cold(bn, unit, cold)) {
+                fprintf(stderr, "dp-bench wide: %s failed\n", d.name.c_str());
+                return false;
+            }
+            printf("{\"wide\": \"%s\", \"weight_bytes\": %zu, \"lanes\": %d, \"rows\": %d, \"total_rows\": %d, "
+                   "\"f16\": %s, \"warm_us\": %.2f, \"cold_us\": %.2f}\n",
+                   d.name.c_str(), g.weight_bytes, c.lanes, c.rows, c.lanes * c.rows, c.f16 ? "true" : "false",
+                   warm.median, cold.median);
+            fflush(stdout);
+        }
+    }
+    return true;
+}
